(version 1)
(rule "JLC pad hole to hole"
  (condition "A.Type == 'Pad' && B.Type == 'Pad'")
  (constraint hole_to_hole (min 0.45mm)))
(rule "JLC PTH hole to copper"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.28mm)))
(rule "JLC SMD pad to pad"
  (condition "A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
  (constraint clearance (min 0.15mm)))
(rule "Check 0.3mm via diameter"
  (condition "A.Type == 'Via' && A.Hole_Size == 0.3mm")
  (constraint via_diameter (min 0.7mm)))